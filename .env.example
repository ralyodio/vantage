# Database
DATABASE_URL="postgresql://vantage:vantage_dev@localhost:5432/vantage?schema=public"

# Redis
# Local (docker-compose): discrete host/port
REDIS_HOST="localhost"
REDIS_PORT=6379
# Hosted (Upstash etc.): a single URL wins over host/port; rediss:// enables TLS
# REDIS_URL="rediss://default:password@host:6379"

# External API Keys (used by both backend and Next.js API routes)
# Get your keys from:
# - Steam: https://steamcommunity.com/dev/apikey
# - Faceit: https://developers.faceit.com/
# - Leetify: Contact Leetify for API access
STEAM_API_KEY="your_steam_api_key_here"
FACEIT_API_KEY="your_faceit_api_key_here"
LEETIFY_API_KEY="your_leetify_api_key_here"

# Server
API_PORT=3001
API_HOST="localhost"   # use 0.0.0.0 inside containers

# CORS: comma-separated browser origins allowed to hit the API directly
# (the Next.js proxy is server-to-server and needs no CORS). Unset = permissive (dev).
# CORS_ORIGIN="https://vantage.vercel.app,https://vantage.example.com"

# Backend API URL (used by Next.js to connect to backend)
BACKEND_API_URL="http://localhost:3001"

# reCAPTCHA (optional, for anti-spam)
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key_here"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"
